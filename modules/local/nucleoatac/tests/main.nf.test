nextflow_pipeline {

    name "Test NUCLEOATAC module harness"
    script "modules/local/nucleoatac/tests/main.nf"

    tag "modules"
    tag "modules_local"
    tag "nucleoatac"

    test("nucleoatac harness - stub") {

        options "-stub"

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.trace.succeeded().size()).match() }
            )
        }
    }
}
